# Node Environment
NODE_ENV=development
PORT=5000

# MongoDB Database URI (MongoDB Atlas or Local MongoDB)
MONGODB_URI=mongodb://127.0.0.1:27017/store_rating_platform

# Authentication Secret (Minimum 16 characters)
JWT_SECRET=production_quality_secret_key_store_rating_challenge_2026
JWT_EXPIRES_IN=7d

# Frontend URL for CORS and CSRF validation
FRONTEND_URL=http://localhost:3000

# Cookie Configuration
COOKIE_NAME=auth_token
COOKIE_SAME_SITE=lax
COOKIE_SECURE=false

# Email / SMTP Configuration (Optional in development - console fallback used when empty)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="NexaPrime Platform <noreply@nexaprime.com>"

# Bayesian Adjusted Rating Parameters
BAYESIAN_MIN_RATINGS=5

# Optional Redis Cache Configuration (Falls back gracefully to in-memory/direct DB when absent)
REDIS_URL=redis://127.0.0.1:6379

# Optional Error Monitoring (Sentry DSN - Startup never blocked if empty)
SENTRY_DSN=

# Optional Geolocation / Mapping Service Key (Google Maps / Mapbox)
MAPS_API_KEY=
