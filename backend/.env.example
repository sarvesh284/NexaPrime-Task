# Node Environment
NODE_ENV=development
PORT=5000

# MongoDB Database URI (MongoDB Atlas or Local MongoDB)
MONGODB_URI=mongodb://127.0.0.1:27017/store_rating_platform

# Authentication Secret (Minimum 16 characters)
JWT_SECRET=production_quality_secret_key_store_rating_challenge_2026
JWT_EXPIRES_IN=7d

# Frontend URL for CORS and CSRF validation
FRONTEND_URL=http://localhost:3000

# Cookie Configuration
COOKIE_NAME=auth_token
COOKIE_SAME_SITE=lax
COOKIE_SECURE=false
